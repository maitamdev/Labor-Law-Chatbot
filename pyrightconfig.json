{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "include": [
    "app", "config", "evaluation", "graph", "ingestion",
    "law_crawler", "models", "rag", "scripts", "ui"
  ],
  "extraPaths": [
    ".",
    ".venv/Lib/site-packages"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    "scratch",
    "build",
    "dist",
    "storage",
    "reports",
    "data"
  ],
  "reportMissingImports": "none",
  "reportAttributeAccessIssue": "none"
}
